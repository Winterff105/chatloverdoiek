* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
}

/* 参考对方项目：html/body 不锁 position:fixed，不用 100dvh，用 min-height:100% 自然撑开。
   真实高度由 index.html 里的脚本写入 --app-height（修复主屏幕模式下少算状态栏高度的 bug） */
html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    height: var(--app-height, 100%);
    overflow: hidden;
    overscroll-behavior: none;
    overscroll-behavior-y: none;
    touch-action: pan-x pan-y;
    background-color: #09090b;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: stretch;
}

/* 手机机身容器：高度直接用脚本算出的真实屏幕高度 */
.phone-container {
    width: 100%;
    max-width: 430px;
    height: var(--app-height, 100%);
    min-height: 100%;
    margin: 0 auto;
    background: transparent;
    position: relative;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    padding-top: max(24px, env(safe-area-inset-top, 0px));
}

.phone-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--wallpaper-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -1;
    pointer-events: none;
}

/* 浅色壁纸时底色同步浅色 */
html:has(.phone-container.theme-light),
body:has(.phone-container.theme-light) {
    background-color: #FCFAFB;
}

html, body {
    background-color: #09090b;
}
